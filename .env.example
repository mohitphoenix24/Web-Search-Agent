# You need at least ONE of these two keys for the online models.

# OpenAI — paid, gives the best answers. https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Groq — has a free tier. https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional — free key from https://app.tavily.com
# Tavily is a search engine built for AI agents: better snippets than a normal
# search. Leave this out and the agent falls back to DuckDuckGo, which is free
# and needs no key.
TAVILY_API_KEY=your_tavily_api_key_here
